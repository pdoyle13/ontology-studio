# Agent (one of these; Grok is primary)
GROK_API_KEY=
ANTHROPIC_API_KEY=
# AGENT_MODEL=grok-4

# Optional: external Elasticsearch/OpenSearch (blank = embedded index)
# SEARCH_URL=

# Optional overrides
# OXIGRAPH_URL=http://localhost:7878
# KAFKA_BROKERS=localhost:19092
# STUDIO_SERVER_PORT=7881

# BI facade: expose business objects to Tableau/Power BI via the Postgres wire
# protocol on this port (blank = off)
# BI_PORT=15440

# Enterprise authn (all optional; header identity works without them)
# AUTH_REQUIRED=1            # writes need a Bearer credential
# OIDC_JWKS_URL=             # e.g. https://idp/realms/x/protocol/openid-connect/certs
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# TOKENS_FILE=               # default server/.state/tokens.json

# Observability
# DD_AGENT_HOST=             # DogStatsD export to a Datadog agent
# DD_DOGSTATSD_PORT=8125
